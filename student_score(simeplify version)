 //学生成绩管理系统
#include <stdio.h>
int main() {

	int n;
	int arr[100];
	int count = 0;
	int max = 0;

	while (1) {
		printf("1:add score ");
		printf("2:show score ");
		printf("3:average score ");
		printf("4:max score ");
		printf("5:exit\n");

		printf("input number\n");
		scanf("%d", &n);

		switch (n) {

		case 1:
			if (count >= 100) {
				printf("list full");
			}
			printf("input score\n");
			scanf("%d", &arr[count]);
			count++;
			break;

		case 2:
			if (count == 0) {
				printf("empty");
			}
			for (int i = 0; i < count; i++)
				printf("shoew score:%d\n", arr[i]);
			break;

		case 3:
			int sum = 0;
			for (int i = 0; i < count; i++) {
				  sum = arr[i] + sum;
			}
			if (count > 0) {
				printf("average score:%d\n", sum / count);
			}
			break;

		case 4:
			for (int i = 0; i < count; i++) {
				if (arr[i] > max) {
					max = arr[i];
				}
			}
            printf("%d\n", max);
			break;

		case 5:
			return 0;
		}
	}
	return 0;
}
